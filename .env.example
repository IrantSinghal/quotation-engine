# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────
# PostgreSQL Database
# ─────────────────────────────────────────────
DB_HOST=db.zevonsubuvtywgscuksj.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=Irant@Singhal
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_minimum_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_minimum_64_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────
# Google OAuth 2.0
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─────────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
